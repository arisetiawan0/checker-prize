# Salin jadi .env.local lalu isi. Tanpa env ini aplikasi tetap jalan
# memakai 30 produk demo (lihat web/lib/catalog.ts).

# --- Google Sheets (PRD §7.2) ---
# id spreadsheet: bagian /d/<INI_ID>/edit dari URL spreadsheet
SPREADSHEET_ID=
# client_email & private_key dari file JSON service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIB...\n-----END PRIVATE KEY-----\n"
# opsional — batas area baca & nama tab
SHEET_RANGE=A1:Z5000
SHEET_TAB=

# --- Akses staff (PRD §7.3) ---
# kode akses 6 digit; kosong = "280101" (demo)
STAFF_PIN=
# opsional — kunci HMAC cookie; kosong = diturunkan dari STAFF_PIN
AUTH_SECRET=
