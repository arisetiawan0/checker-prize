# Salin jadi .env.local lalu isi. Tanpa env ini aplikasi tetap jalan
# memakai data demo (lihat web/lib/catalog.ts).

# --- Google Sheets (PRD §7.2) ---
# id spreadsheet: bagian /d/<INI_ID>/edit dari URL spreadsheet
SPREADSHEET_ID=
# client_email & private_key dari file JSON service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIB...\n-----END PRIVATE KEY-----\n"

# Nama tab spreadsheet promo (default seperti spreadsheet Warehouse Lippo Plaza)
SHEET_TAB_PROMO=SKU PROMO
SHEET_TAB_ONLY_REGULER=ONLY DISC REGULER
SHEET_TAB_ONLY_FLASH=ONLY FLASH SALE
SHEET_TAB_LT_PRO=LT PRO

# --- Jadwal event & sesi flash sale (WITA) ---
EVENT_START=2026-11-05
EVENT_END=2026-11-08
# daftar sesi flash harian, dipisah koma
FLASH_SESSIONS=12:00-13:00, 15:00-16:00, 18:30-19:30

# --- Akses staff (PRD §7.3) ---
# kode akses 6 digit; kosong = "280101" (demo)
STAFF_PIN=
# opsional — kunci HMAC cookie; kosong = diturunkan dari STAFF_PIN
AUTH_SECRET=
